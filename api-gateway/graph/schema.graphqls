type Note {
  id: ID!
  title: String!
  content: String!
  userId: String!
  createdAt: String!
  updatedAt: String!
}

input CreateNoteInput {
  title: String!
  content: String!
  userId: String!
}

input UpdateNoteInput {
  id: ID!
  title: String!
  content: String!
  userId: String!
}

type NoteChange {
  type: NoteChangeType!
  note: Note!
}

enum NoteChangeType {
  CREATED
  UPDATED
  DELETED
}

type Query {
  getNote(id: ID!, userId: String!): Note
  listNotes(userId: String!): [Note!]!
}

type Mutation {
  createNote(input: CreateNoteInput!): Note!
  updateNote(input: UpdateNoteInput!): Note!
  deleteNote(id: ID!, userId: String!): Boolean!
}

type Subscription {
  watchNotes(userId: String!): NoteChange!
}